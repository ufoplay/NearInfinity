
# import "./just/build.just"
# export RUST_BACKTRACE := "full"

# Lists all the available commands
default:
  @just --list


# Cleans the build artifacts
[group('build')]
clean:
  rm -rf build
  rm NearInfinity.jar


# Builds NI
[group('build')]
build:
  ant


# Recreate parse tree
# NI's BCS compiler uses code that is generated by the parser generator JavaCC. The file src/org/infinity/resource/bcs/parser/BafParser.jjt is used to build the parse tree.
[group('build')]
parser_generate:
  ant parser-clean
  ant parser-generate


# Run NI with local Baldur's Gate
[group('run')]
run_bg: build
  java -jar NearInfinity.jar -i "/home/ufo/Temp/Games/Baldur's Gate/"

# Run NI with local Baldur's Gate - Enhanced Edition
[group('run')]
run_bgee: build
  java -jar NearInfinity.jar -i "/home/ufo/Temp/Games/Baldur's Gate - Enhanced Edition"

